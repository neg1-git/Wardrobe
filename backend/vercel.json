{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/auth/$1"
    },
    {
      "source": "/outfit/(.*)",
      "destination": "/outfit/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
